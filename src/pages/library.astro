---
import Layout from "../layouts/Layout.astro";
import DirectoryListing from "../components/DirectoryListing.astro";
import { library } from "../data/library";

const entries = [
  ...Object.entries(library).map(([name, node]) => ({
    name: `${name}/`,
    href: `/library/${name}/`,
    description: node.description,
    date: "",
  })),

  {
    name: "vector-space-explorer*",
    href: "/vector-space",
    description: "view archive geometrically",
    date: "",
  },
];
---

<Layout path="/edinh/library/">
  <DirectoryListing entries={entries} />
</Layout>
