---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main
    class="min-h-screen flex flex-col items-center justify-center text-center relative overflow-hidden font-mono text-white bg-transparent"
  >
    <h1 class="page-title text-2xl md:text-4xl mb-10 z-10 tracking-widest">
      Which Node Would You Like to Access?
    </h1>

    <!-- 
███████ ██   ██  ██████ ██    ██ ███████ ███████     ███    ███ ███████ 
██       ██ ██  ██      ██    ██ ██      ██          ████  ████ ██      
█████     ███   ██      ██    ██ ███████ █████       ██ ████ ██ █████   
██       ██ ██  ██      ██    ██      ██ ██          ██  ██  ██ ██      
███████ ██   ██  ██████  ██████  ███████ ███████     ██      ██ ███████ 
                                                                        


Can I have some privacy please? 
-->

    <div id="particles-js" class="fixed inset-0 -z-10 w-full h-full"></div>

    <!-- memory nodes -->
    <div id="memory-space" class="fixed inset-0 z-20">
      <!-- left brain nodes -->

      <!-- href="/cv" -->
      <a
        href="javascript:cv(0);"
        id="secret-node"
        class="node left"
        style="top: 20%; left: 18%;">Curriculum Vitae</a
      >
      <a
        href="https://github.com/exd1000"
        target="_blank"
        class="node left"
        style="top: 65%; left: 10%;">GitHub</a
      >
      <!-- <a href="/research" class="node left" style="top: 35%; left: 14%;"
        >Research Focus</a> -->

      <a href="/why" class="node left" style="top: 35%; left: 12%;"
        >Why This Matters</a
      >

      <!-- right brain nodes -->

      <a href="/blank" class="node right" style="top:20%; right: 8%;"
        >My Default Node</a
      >

      <a href="/exdnet" class="node left" style="top: 35%; right: 12%;"
        >EXD-Net</a
      >
      <a
        href="https://dimensionaldrift.substack.com/"
        target="_blank"
        class="node right"
        style="bottom: 40%; right: 8%;">Substack</a
      >
      <!-- <a href="/thoughts" class="node right" style="top: 35%; right: 12%;"
        >3AM Thoughts</a
      > -->
      <!-- <a href="/contact" class="node right" style="top: 55%; right: 14%;"
        >Contact Me</a
      > -->
      <a href="/benji" class="node right" style="bottom: 25%; right: 20%;"
        >♥︎ Benjison ♥︎</a
      >

      <!-- connecting/center nodes -->
      <a href="/" class="node center" style="top: 3%; left: 48%;">Home</a>
      <a href="/about" class="node center" style="top: 13%; left: 47%;"
        >Who Am I?</a
      >
    </div>

    <style>
      main {
        background: transparent !important;
      }
      /* intro style */
      .page-title {
        font-family: monospace;
        color: rgba(255, 255, 255, 0.75);
        letter-spacing: 0.1em;
        text-shadow: 0 0 6px rgba(168, 85, 247, 0.25);
        animation: titleGlow 6s ease-in-out infinite;
        background: rgba(0, 0, 0, 0.3);
        padding: 0.5rem 1rem;
        border-radius: 4px;
        backdrop-filter: blur(2px);
      }

      @keyframes titleGlow {
        0%,
        100% {
          opacity: 0.7;
          text-shadow: 0 0 6px rgba(168, 85, 247, 0.3);
        }
        50% {
          opacity: 1;
          text-shadow: 0 0 18px rgba(168, 85, 247, 0.6);
        }
      }

      /* hemisphere vibes  */
      #particles-js::before,
      #particles-js::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        mix-blend-mode: screen;
        z-index: 1;
      }

      /* Base static hemisphere glow (left + right balance) */
      #particles-js::before {
        background:
          radial-gradient(
            circle at 20% 50%,
            rgba(110, 165, 255, 0.28),
            transparent 60%
          ),
          radial-gradient(
            circle at 80% 50%,
            rgba(225, 140, 255, 0.28),
            transparent 60%
          ),
          linear-gradient(
            to right,
            rgba(110, 165, 255, 0.18),
            rgba(176, 132, 249, 0.22) 50%,
            rgba(225, 140, 255, 0.18)
          );
        filter: blur(2px);
      }

      /* Breathing glow overlay (pulsating lilac haze) */
      /* Gradient Hemisphere Aura */
      #particles-js::before,
      #particles-js::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        mix-blend-mode: screen;
        z-index: 1;
      }

      /* Base static glow (anchors the hemispheres) */
      #particles-js::before {
        background:
          radial-gradient(
            circle at 20% 50%,
            rgba(110, 165, 255, 0.25),
            transparent 60%
          ),
          radial-gradient(
            circle at 80% 50%,
            rgba(225, 140, 255, 0.25),
            transparent 60%
          ),
          linear-gradient(
            to right,
            rgba(110, 165, 255, 0.18),
            rgba(176, 132, 249, 0.25) 50%,
            rgba(225, 140, 255, 0.18)
          );
        filter: blur(2px);
      }

      /* gradient overlay */
      #particles-js::after {
        background: linear-gradient(
          90deg,
          rgba(110, 165, 255, 0.15),
          rgba(176, 132, 249, 0.25),
          rgba(225, 140, 255, 0.15)
        );
        background-size: 200% 200%;
        animation: gradientBreathe 12s ease-in-out infinite;
        filter: blur(4px);
      }

      @keyframes gradientBreathe {
        0% {
          background-position: 0% 50%;
          opacity: 0.35;
        }
        25% {
          background-position: 25% 50%;
          opacity: 0.5;
        }
        50% {
          background-position: 100% 50%;
          opacity: 0.65;
        }
        75% {
          background-position: 75% 50%;
          opacity: 0.5;
        }
        100% {
          background-position: 0% 50%;
          opacity: 0.35;
        }
      }

      /* memory nodes style */
      .node {
        position: absolute;
        color: rgba(255, 255, 255, 0.45);
        font-weight: 300;
        letter-spacing: 0.05em;
        font-size: 0.85rem;
        padding: 0.15rem 0.4rem;
        border-radius: 2px;
        background: transparent;
        text-decoration: none;
        pointer-events: auto;
        transition: all 0.3s ease;
        animation: nodeGlow 6s ease-in-out infinite;
        animation-delay: calc(var(--delay, 0) * 1s);
      }

      /* LEFT HEMISPHERE —  blue */
      .node.left {
        text-shadow: 0 0 10px rgba(110, 165, 255, 0.35);
      }
      .node.left:hover {
        text-shadow: 0 0 15px rgba(130, 190, 255, 0.8);
        box-shadow: 0 0 10px rgba(130, 190, 255, 0.4);
      }

      /* RIGHT HEMISPHERE — red */
      .node.right {
        text-shadow: 0 0 10px rgba(225, 140, 255, 0.35);
      }
      .node.right:hover {
        text-shadow: 0 0 15px rgba(227, 37, 88, 0.8);
        box-shadow: 0 0 10px rgba(255, 160, 255, 0.4);
      }

      /* CENTER —  white */
      .node.center {
        text-shadow: 0 0 10px rgba(176, 132, 249, 0.5);
      }
      .node.center:hover {
        text-shadow: 0 0 18px rgba(201, 180, 234, 0.9);
        box-shadow: 0 0 12px rgba(176, 132, 249, 0.6);
      }

      /* random delays per node */
      .node:nth-child(1) {
        --delay: 0;
      }
      .node:nth-child(2) {
        --delay: 1.2;
      }
      .node:nth-child(3) {
        --delay: 2.4;
      }
      .node:nth-child(4) {
        --delay: 3.6;
      }
      .node:nth-child(5) {
        --delay: 4.2;
      }
      .node:nth-child(6) {
        --delay: 2.1;
      }
      .node:nth-child(7) {
        --delay: 5.1;
      }
      .node:nth-child(8) {
        --delay: 1.8;
      }
      .node:nth-child(9) {
        --delay: 3.3;
      }
      .node:nth-child(10) {
        --delay: 0.9;
      }
      .node:nth-child(11) {
        --delay: 4.8;
      }
      .node:nth-child(12) {
        --delay: 1.6;
      }

      .node:hover {
        color: #fff;
        background: rgba(168, 85, 247, 0.3);
        box-shadow: 0 0 8px rgba(168, 85, 247, 0.5);
        text-shadow: 0 0 6px rgba(255, 255, 255, 0.8);
        transform: scale(1.03);
        padding: 0 0.5rem; /* tighter fit */
        border-radius: 1px; /* crisp corners */
        animation: none;
      }

      @keyframes nodeGlow {
        0%,
        100% {
          opacity: 0.4;
          text-shadow: 0 0 4px rgba(168, 85, 247, 0.15);
        }
        50% {
          opacity: 0.9;
          text-shadow: 0 0 14px rgba(168, 85, 247, 0.45);
        }
      }

      /* holographic modal styling */
      .modal-panel {
        background: radial-gradient(
          circle at 50% 20%,
          rgba(176, 132, 249, 0.25),
          rgba(0, 0, 0, 0.75)
        );
        border: 1px solid rgba(176, 132, 249, 0.25);
        box-shadow:
          0 0 20px rgba(176, 132, 249, 0.25),
          0 0 60px rgba(176, 132, 249, 0.1);
        font-family: "Share Tech Mono", monospace;
        color: #e5dfff;
        letter-spacing: 0.03em;
        backdrop-filter: blur(14px);
      }

      /* title */
      .modal-panel h2 {
        color: #d9c2ff;
        text-shadow: 0 0 10px rgba(176, 132, 249, 0.5);
        margin-bottom: 1.25rem;
      }

      /* input field */
      #password-input {
        background: rgba(255, 255, 255, 0.05);
        color: #e6dfff;
        border: 1px solid rgba(176, 132, 249, 0.4);
        border-radius: 8px;
        padding: 0.6rem 0.8rem;
        transition: all 0.25s ease;
      }
      #password-input:focus {
        border-color: rgba(225, 140, 255, 0.7);
        box-shadow: 0 0 12px rgba(176, 132, 249, 0.5);
      }

      /* buttons */
      .modal-btn {
        font-family: "Share Tech Mono", monospace;
        letter-spacing: 0.03em;
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      /* Unlock + Request Access */
      .modal-btn.unlock,
      .modal-btn.request {
        background: linear-gradient(
          135deg,
          rgba(176, 132, 249, 0.85),
          rgba(225, 140, 255, 0.85)
        );
        color: white;
        text-shadow: 0 0 5px rgba(255, 255, 255, 0.5);
        animation: buttonBreathe 6s ease-in-out infinite;
      }

      .modal-btn.unlock:hover,
      .modal-btn.request:hover {
        background: linear-gradient(
          135deg,
          rgba(225, 140, 255, 1),
          rgba(176, 132, 249, 1)
        );
        box-shadow: 0 0 15px rgba(176, 132, 249, 0.7);
        transform: scale(1.05);
      }

      /* Cancel */
      .modal-btn.cancel {
        background: rgba(90, 90, 110, 0.6);
        color: #ddd;
      }
      .modal-btn.cancel:hover {
        background: rgba(110, 110, 130, 0.9);
        box-shadow: 0 0 10px rgba(176, 132, 249, 0.3);
      }

      /* pulse */
      @keyframes buttonBreathe {
        0%,
        100% {
          box-shadow: 0 0 8px rgba(176, 132, 249, 0.3);
        }
        50% {
          box-shadow: 0 0 20px rgba(225, 140, 255, 0.5);
        }
      }
    </style>

    <!-- password stuff -->
    <div
      id="password-modal"
      class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50 backdrop-blur-sm"
    >
      <div class="modal-panel text-center max-w-sm w-full mx-4 p-8 rounded-2xl">
        <h2 class="text-xl font-semibold mb-4 tracking-wide">
          Memory Access Required
        </h2>

        <input
          id="password-input"
          type="password"
          placeholder="Enter authorization key"
          class="w-full px-3 py-2 mb-5 rounded-md text-sm tracking-wide outline-none"
        />

        <div class="flex justify-center gap-4">
          <button id="password-submit" class="modal-btn unlock"
            >Unlock Memory</button
          >
          <button
            onclick="window.location.href='/contact'"
            class="modal-btn request">Request Access</button
          >
          <button id="password-cancel" class="modal-btn cancel">Cancel</button>
        </div>
      </div>
    </div>

    <div
      id="memory-failed"
      class="hidden fixed inset-0 bg-black/90 flex items-center justify-center z-50"
    >
      <div class="glitch-text text-2xl animate-glitch">
        Memory Retrieval Failed
      </div>
    </div>

    <!-- particle background + connections -->
    <script
      src="https://cdn.jsdelivr.net/npm/tsparticles@2/tsparticles.bundle.min.js"
    ></script>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        tsParticles.load("particles-js", {
          background: { color: "#000000" },
          fpsLimit: 60,
          interactivity: {
            events: {
              onHover: { enable: true, mode: "grab" },
              onClick: { enable: false },
              resize: true,
            },
            modes: {
              grab: {
                distance: 200,
                links: {
                  opacity: 0.8,
                  color: "#b084f9",
                },
              },
            },
          },
          particles: {
            color: { value: "#b084f9" },
            links: {
              color: "#b084f9",
              distance: 250, // longer connections
              enable: true,
              opacity: 0.25,
              width: 1.1,
              triangles: { enable: false },
            },
            move: {
              direction: "none",
              enable: true,
              outModes: { default: "bounce" },
              random: true,
              speed: 0.25,
              straight: false,
            },
            number: { value: 45, density: { enable: true, area: 800 } },
            opacity: { value: { min: 0.3, max: 0.8 } },
            shape: { type: "circle" },
            size: { value: { min: 0.8, max: 2.5 } },
          },
          detectRetina: true,
        });
      });

      // more password stuff
      let targetPage = "";

      document.addEventListener("DOMContentLoaded", () => {
        const secretNode = document.getElementById("secret-node");
        const submitButton = document.getElementById("password-submit");
        const cancelButton = document.getElementById("password-cancel");

        secretNode.addEventListener("click", (e) => {
          e.preventDefault();
          openPasswordModal("/cv");
        });

        submitButton.addEventListener("click", submitPassword);
        cancelButton.addEventListener("click", closePasswordModal);
      });

      function openPasswordModal(page) {
        targetPage = page;
        document.getElementById("password-modal").classList.remove("hidden");
        document.getElementById("password-input").value = "";
        document.getElementById("password-input").focus();
      }

      function closePasswordModal() {
        document.getElementById("password-modal").classList.add("hidden");
      }

      function submitPassword() {
        const input = document.getElementById("password-input").value;
        const correctPassword = "luckyyou";

        if (input === correctPassword) {
          sessionStorage.setItem("cvUnlocked", "true");
          sessionStorage.setItem("isExternalEntry", "false");
          window.location.assign("/cv");
        } else {
          closePasswordModal();
          triggerMemoryFailed();
        }
      }

      function triggerMemoryFailed() {
        const failed = document.getElementById("memory-failed");
        failed.classList.remove("hidden");
        setTimeout(() => {
          failed.classList.add("hidden");
        }, 2000);
      }

      // void redirect
      console.log(
        "%cA memory once sealed cannot be retrieved. ✨\n\nBut some memories... they leak.\nTry typing: unlock('exd1000')",
        "color: #9d7edb; font-size: 12px; font-family: mono;",
      );

      window.unlock = function (key) {
        if (key === "exd1000") {
          alert(
            "Key sequence accepted 🔓.\n\nAccess granted to an encrypted memory.",
          );
          history.replaceState({ trapRoot: true }, "", "/void");
          location.replace("/void");
        } else {
          alert("Unrecognized fragment.");
        }
      };
    </script>
  </main>
</Layout>
