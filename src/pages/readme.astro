---
import Layout from "../layouts/Layout.astro";
---

<Layout path="/edinh/README.md">
  <nav>
    <a href="/">../</a><br />
  </nav>
  <main
    class="flex flex-col items-center justify-center min-h-screen text-white font-mono px-6 py-16 text-center"
  >
    <h1 class="text-4xl md:text-6xl mb-8 animate-fade-in-slow">README.md</h1>

    <p
      class="max-w-3xl text-base md:text-lg leading-relaxed animate-fade-in-slow opacity-80"
    >
      So..... this is awkward
    </p>
  </main>

  <style>
    .animate-fade-in-slow {
      opacity: 0;
      transform: translateY(20px);
      animation: floatFade 2.2s ease forwards;
    }

    @keyframes floatFade {
      to {
        opacity: 0.8;
        transform: translateY(0);
      }
    }

    html,
    body {
      min-height: 100%;
      margin: 0;
      overflow-y: auto;
    }

    body::-webkit-scrollbar {
      display: none;
    }

    body {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</Layout>
