---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main
    class="flex flex-col items-center justify-center min-h-screen text-white font-mono px-6 py-20 text-center"
  >
    <!-- Main message -->
    <h1
      class="text-gray-300 text-2xl md:text-3xl uppercase tracking-wide mb-2 animate-fade-in"
    >
      Private during active development
      <!-- PRIVATE DURING ACTIVE DEVELOPMENT. -->
    </h1>

    <p class="text-[0.8rem] tracking-wide text-gray-600 uppercase italic mb-6">
      Selected figures from ongoing experiments
    </p>

    <!-- Figures -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl w-full items-start"
    >
      <!-- Figure 1 -->
      <div class="flex flex-col items-center">
        <img
          src="/images/pixel_match.png"
          alt="Pattern reconstruction after representational drift"
          class="w-full h-72 object-contain rounded-lg border border-neutral-800 bg-white"
        />

        <p
          class="mt-2 text-xs text-gray-500 max-w-md leading-relaxed text-left"
        >
          <span class="font-semibold text-gray-300">Figure 1.</span>
          Pattern reconstruction following representational drift. Recalled attractor
          states under two memory conditions.
        </p>
      </div>

      <!-- Figure 2 -->
      <div class="flex flex-col items-center">
        <img
          src="/images/weight_before_after.png"
          alt="Weight matrix evolution during memory updating"
          class="w-full h-72 object-contain rounded-lg border border-neutral-800 bg-white"
        />

        <p
          class="mt-2 text-xs text-gray-500 max-w-md leading-relaxed text-left"
        >
          <span class="font-semibold text-gray-300">Figure 2.</span>
          Evolution of the Hopfield weight matrix following perturbation-induced memory
          updating.
        </p>
      </div>
    </div>
  </main>
</Layout>
