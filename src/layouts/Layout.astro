---
import "../styles/global.css";

interface Props {
  path?: string;
  description?: string;
}

const {
  path = "/edinh/",
  description = "Personal research portfolio and digital archive of E. Dinh",
} = Astro.props;

const title = `Index of ${path}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <em>server under construction</em>
      <hr />

      <slot />

      <hr />
      <footer>
        <em>exd1000/2.4.48 (edinh) Server at exd1000.github.io Port 443</em>
      </footer>
    </main>
  </body>
</html>
